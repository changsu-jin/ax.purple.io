---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusConfig: Record<string, { color: string; text: string; bg: string }> = {
  '운영 중': { color: 'bg-green-400', text: 'text-green-400', bg: 'bg-green-400/10' },
  '진행 중': { color: 'bg-blue-400', text: 'text-blue-400', bg: 'bg-blue-400/10' },
  '기획 중': { color: 'bg-yellow-400', text: 'text-yellow-400', bg: 'bg-yellow-400/10' },
};
const sc = statusConfig[project.data.status] ?? statusConfig['기획 중'];
const contributors = project.data.contributors ?? [];
---

<Base title={project.data.title} description={project.data.summary}>
  <article class="max-w-3xl mx-auto px-6 pt-14 pb-20">
    <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-accent transition-colors group">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Projects
    </a>

    <div class="mt-8 flex items-center gap-2">
      <span class={`inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-full ${sc.bg} ${sc.text}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${sc.color}`}></span>
        {project.data.status}
      </span>
      {project.data.category === 'opensource' && (
        <span class="inline-flex items-center gap-1 text-[11px] font-medium text-gray-500 border border-border-default rounded-full px-2.5 py-1">
          <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Open Source
        </span>
      )}
    </div>

    <h1 class="mt-4 text-3xl sm:text-4xl font-bold text-white tracking-tight">{project.data.title}</h1>
    <p class="mt-3 text-lg text-gray-400 leading-relaxed">{project.data.summary}</p>

    {project.data.approach && (
      <p class="mt-3 text-sm text-accent/80 italic">{project.data.approach}</p>
    )}

    <div class="mt-4 flex items-center gap-4">
      {project.data.repo && (
        <a
          href={project.data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-accent transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          GitHub
        </a>
      )}
      {project.data.owner?.blog && (
        <a
          href={project.data.owner.blog}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-accent transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          Blog
        </a>
      )}
    </div>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {project.data.tags.map((tag: string) => (
        <span class="text-[11px] px-2 py-0.5 rounded-md bg-gray-800/60 text-gray-500">{tag}</span>
      ))}
    </div>

    <!-- Owner & Contributors -->
    {project.data.owner && (
      <div class="mt-6 flex items-center gap-4 p-4 rounded-lg bg-surface-card border border-border-subtle">
        <Avatar name={project.data.owner.name} avatar={project.data.owner.avatar} size="lg" />
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-300">{project.data.owner.name}</p>
          <p class="text-[11px] text-gray-600">Owner</p>
        </div>
        {contributors.length > 0 && (
          <div class="text-right">
            <p class="text-xs text-gray-400">{contributors.map(c => c.name).join(', ')}</p>
            <p class="text-[11px] text-gray-600">Contributors</p>
          </div>
        )}
      </div>
    )}

    <hr class="border-border-subtle my-10" />

    <div class="prose prose-invert prose-gray max-w-none
      prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
      prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-gray-300 prose-p:leading-relaxed
      prose-li:text-gray-300 prose-li:leading-relaxed
      prose-strong:text-white
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-code:text-purple-300 prose-code:bg-gray-800/60 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-sm
      prose-pre:bg-surface-card prose-pre:border prose-pre:border-border-subtle prose-pre:rounded-xl
      prose-blockquote:border-accent-dim prose-blockquote:text-gray-400
      prose-table:text-sm
      prose-th:text-gray-300 prose-th:font-semibold prose-th:border-border-default prose-th:py-2 prose-th:px-3
      prose-td:text-gray-400 prose-td:border-border-subtle prose-td:py-2 prose-td:px-3">
      <Content />
    </div>
  </article>
</Base>
