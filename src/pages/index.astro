---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const internalProjects = projects.filter((p) => p.data.category === 'internal');
const opensourceProjects = projects.filter((p) => p.data.category === 'opensource');
const externalProjects = projects.filter((p) => p.data.category === 'external');

const posts = await getCollection('blog');
const recentPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const statusConfig: Record<string, { color: string; text: string; bg: string }> = {
  '운영 중': { color: 'bg-green-400', text: 'text-green-400', bg: 'bg-green-400/10' },
  '진행 중': { color: 'bg-blue-400', text: 'text-blue-400', bg: 'bg-blue-400/10' },
  '기획 중': { color: 'bg-yellow-400', text: 'text-yellow-400', bg: 'bg-yellow-400/10' },
};
---

<Base title="Home" description="Purple AX - 기술로 비즈니스 운영을 바꿉니다">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 pt-20 sm:pt-28 pb-20">
    <p class="text-accent text-sm font-semibold tracking-wide uppercase mb-4">AX TF</p>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-[1.1]">
      기술로 비즈니스<br />운영을 바꿉니다
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-gray-400 max-w-2xl leading-relaxed">
      운영 자동화, 개발 생산성, 오픈소스 &mdash;<br class="hidden sm:block" />
      purpleio AX TF가 만들고 있는 것들을 소개합니다.
    </p>
    <div class="mt-8 flex gap-3">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-medium px-5 py-2.5 rounded-lg bg-accent-dim hover:bg-accent text-white transition-colors"
      >
        프로젝트 보기
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="/blog"
        class="inline-flex items-center text-sm font-medium px-5 py-2.5 rounded-lg border border-border-default text-gray-300 hover:text-white hover:border-gray-500 transition-colors"
      >
        블로그
      </a>
    </div>
  </section>

  <!-- Quick Win Banner -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <a
      href="https://quickwin.purple.io/"
      target="_blank"
      rel="noopener noreferrer"
      class="group block rounded-xl border border-accent-dim/30 bg-gradient-to-r from-accent-dim/10 to-surface-card hover:from-accent-dim/20 hover:border-accent-dim/50 transition-all duration-200"
    >
      <div class="p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] font-medium text-accent bg-accent/10 rounded-full px-2.5 py-0.5">AI Quick Win</span>
            <span class="text-[11px] text-gray-500">2026.02</span>
          </div>
          <h3 class="text-lg font-bold text-white">2주 만에, 전 직군이 만든 28개의 AI 과제</h3>
          <p class="mt-1 text-sm text-gray-400">10개 부서 참여, 평균 83% 시간 절감 — AI로 실무 문제를 해결한 기록</p>
        </div>
        <span class="inline-flex items-center gap-1.5 text-sm text-accent group-hover:gap-2.5 transition-all shrink-0">
          자세히 보기
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </a>
  </section>

  <!-- Open Source Projects -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-bold text-white">오픈소스</h2>
        <span class="text-[11px] font-medium text-gray-500 border border-border-default rounded-full px-2.5 py-0.5">GitHub</span>
      </div>
      <a href="/projects" class="text-sm text-accent hover:text-purple-300 transition-colors">
        전체 보기 &rarr;
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {opensourceProjects.map((project) => {
        const sc = statusConfig[project.data.status] ?? statusConfig['기획 중'];
        return (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-xl border border-border-subtle bg-surface-card hover:bg-surface-hover hover:border-border-default transition-all duration-200"
          >
            <div class="p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-0.5 rounded-full ${sc.bg} ${sc.text}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${sc.color}`}></span>
                      {project.data.status}
                    </span>
                    {project.data.repo && (
                      <span class="inline-flex items-center gap-1 text-[11px] text-gray-600">
                        <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                        </svg>
                        MIT
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors">{project.data.title}</h3>
                  <p class="mt-2 text-sm text-gray-400 leading-relaxed line-clamp-2">{project.data.summary}</p>
                </div>
                {project.data.owner?.blog && (
                  <span class="shrink-0 inline-flex items-center gap-1 text-[11px] text-gray-500 hover:text-accent transition-colors" onclick={`event.preventDefault(); event.stopPropagation(); window.open('${project.data.owner.blog}', '_blank')`}>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                    {new URL(project.data.owner.blog).hostname}
                  </span>
                )}
              </div>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="text-[11px] px-2 py-0.5 rounded-md bg-gray-800/60 text-gray-500">{tag}</span>
                ))}
              </div>
              {project.data.owner && (
                <div class="mt-4 pt-4 border-t border-border-subtle flex items-center gap-3">
                  <Avatar name={project.data.owner.name} avatar={project.data.owner.avatar} size="lg" />
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-300">{project.data.owner.name}</p>
                    <p class="text-[11px] text-gray-600">Owner</p>
                  </div>
                  {(project.data.contributors ?? []).length > 0 && (
                    <p class="text-xs text-gray-400">{(project.data.contributors ?? []).map(c => c.name).join(', ')}</p>
                  )}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Internal Projects -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-bold text-white">내부 프로젝트</h2>
        <span class="text-[11px] font-medium text-gray-500 border border-border-default rounded-full px-2.5 py-0.5">AX TF</span>
      </div>
      <a href="/projects" class="text-sm text-accent hover:text-purple-300 transition-colors">
        전체 보기 &rarr;
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {internalProjects.map((project) => {
        const sc = statusConfig[project.data.status] ?? statusConfig['기획 중'];
        const contributors = project.data.contributors ?? [];
        return (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-xl border border-border-subtle bg-surface-card hover:bg-surface-hover hover:border-border-default transition-all duration-200"
          >
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class={`inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-0.5 rounded-full ${sc.bg} ${sc.text}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${sc.color}`}></span>
                  {project.data.status}
                </span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors">{project.data.title}</h3>
              <p class="mt-2 text-sm text-gray-400 leading-relaxed line-clamp-2">{project.data.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.data.tags.map((tag: string) => (
                  <span class="text-[11px] px-2 py-0.5 rounded-md bg-gray-800/60 text-gray-500">{tag}</span>
                ))}
              </div>
              {project.data.owner && (
                <div class="mt-4 pt-4 border-t border-border-subtle flex items-center gap-3">
                  <Avatar name={project.data.owner.name} avatar={project.data.owner.avatar} size="lg" />
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-300">{project.data.owner.name}</p>
                    <p class="text-[11px] text-gray-600">Owner</p>
                  </div>
                  {contributors.length > 0 && (
                    <p class="text-xs text-gray-400">{contributors.map(c => c.name).join(', ')}</p>
                  )}
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- External AX Projects -->
  {externalProjects.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-20">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <h2 class="text-xl font-bold text-white">외부 AX</h2>
          <span class="text-[11px] font-medium text-gray-500 border border-border-default rounded-full px-2.5 py-0.5">고객사</span>
        </div>
        <a href="/projects" class="text-sm text-accent hover:text-purple-300 transition-colors">
          전체 보기 &rarr;
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {externalProjects.map((project) => {
          const sc = statusConfig[project.data.status] ?? statusConfig['기획 중'];
          const contributors = project.data.contributors ?? [];
          return (
            <a
              href={`/projects/${project.id}`}
              class="group block rounded-xl border border-border-subtle bg-surface-card hover:bg-surface-hover hover:border-border-default transition-all duration-200"
            >
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class={`inline-flex items-center gap-1.5 text-[11px] font-medium px-2 py-0.5 rounded-full ${sc.bg} ${sc.text}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${sc.color}`}></span>
                    {project.data.status}
                  </span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors">{project.data.title}</h3>
                <p class="mt-2 text-sm text-gray-400 leading-relaxed line-clamp-2">{project.data.summary}</p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {project.data.tags.slice(0, 4).map((tag: string) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-gray-800/60 text-gray-500">{tag}</span>
                  ))}
                </div>
                {project.data.owner && (
                  <div class="mt-4 pt-4 border-t border-border-subtle flex items-center gap-3">
                    <Avatar name={project.data.owner.name} avatar={project.data.owner.avatar} size="lg" />
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-300">{project.data.owner.name}</p>
                      <p class="text-[11px] text-gray-600">Owner</p>
                    </div>
                    {contributors.length > 0 && (
                      <p class="text-xs text-gray-400">{contributors.map(c => c.name).join(', ')}</p>
                    )}
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Recent Blog Posts -->
  {recentPosts.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-20">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-white">Recent Posts</h2>
        <a href="/blog" class="text-sm text-accent hover:text-purple-300 transition-colors">
          전체 보기 &rarr;
        </a>
      </div>
      <div class="grid gap-5">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block rounded-xl border border-border-subtle bg-surface-card hover:bg-surface-hover hover:border-border-default transition-all duration-200"
          >
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
                <time>{post.data.date.toISOString().split('T')[0]}</time>
                <span class="text-gray-700">&middot;</span>
                <span>{post.data.author}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors">{post.data.title}</h3>
              <p class="mt-2 text-sm text-gray-400 leading-relaxed">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
